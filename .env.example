# Copy to .env.local for `vercel dev`. In production set these in Vercel → Project → Settings → Environment Variables.

# --- Browser (exposed to the page; safe to publish) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_GITSUM_PRICE_LABEL=$5

# --- Server only (never prefix with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=            # the $5/month recurring price
STRIPE_WEBHOOK_SECRET=      # from the webhook endpoint pointing at /api/stripe-webhook
PUBLIC_SITE_URL=https://grakken-github-repo-analyser.vercel.app

# Shared limits across all serverless instances (Upstash Redis via the Vercel Marketplace sets these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning
GITSUM_MODEL=claude-haiku-5-5
GITSUM_MAX_TOKENS=1200
GITSUM_MONTHLY_LIMIT=1000        # AI answers per subscriber per month
GITSUM_RATE_PER_MINUTE=12        # burst limit per subscriber
GITSUM_GLOBAL_DAILY_LIMIT=20000  # hard ceiling on all AI answers per day (cost guard)
